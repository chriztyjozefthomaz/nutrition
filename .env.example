# Domain Traefik should route to this app. Point an A record at 147.93.46.40 first.
APP_DOMAIN=ledger.example.com

# Signs the session cookie. Generate with: openssl rand -base64 48
# Changing it later signs everyone out. It does not affect stored data.
SESSION_SECRET=replace-me-with-48-random-bytes

# Creates the accounts on first boot only. Once users exist this is ignored,
# so you can blank it after the first successful start.
# Format: username:password:Display Name:PLAN:startKg:goalKg:heightCm
SEED_USERS=chris:CHANGE-ME:Chris:A:90:76:174,mabel:CHANGE-ME:Mabel:B:68.5:60:162
